---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SkillsGrid from '../components/SkillsGrid.astro';
import Recommendation from '../components/Recommendation.astro';
import { profile } from '../data/profile';
import { profilePageJsonLd, faqPageJsonLd } from '../lib/jsonld';
import headshot from '../assets/media/headshot.png';
const recs = (await getCollection('recommendations')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<BaseLayout title="About" description={profile.shortBio.slice(0, 158) + '…'} path="/about" jsonLd={[profilePageJsonLd(profile, Astro.site!.origin), faqPageJsonLd(profile.faq)]}>
  <div class="container-page py-12 sm:py-16">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start">
      <Picture src={headshot} alt="Portrait of Youssef Alouani" widths={[128, 256]} sizes="128px" formats={['avif', 'webp']} class="h-32 w-32 rounded-full border border-border object-cover" />
      <div class="max-w-[70ch]">
        <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">About</h1>
        <div class="mt-6 space-y-4">{profile.longBio.map((p) => <p>{p}</p>)}</div>
      </div>
    </div>

    <section class="mt-16" aria-labelledby="languages-h">
      <h2 id="languages-h" class="eyebrow">Languages</h2>
      <p class="mt-2">{profile.languages.map((l) => l.name).join(', ')}</p>
    </section>

    <section id="skills" class="mt-16" aria-labelledby="skills-h">
      <h2 id="skills-h" class="text-xl font-semibold">Skills</h2>
      <p class="mt-2 text-muted">Grouped by what I build. Each one is backed by a role or project.</p>
      <div class="mt-6"><SkillsGrid /></div>
    </section>

    <section id="recommendations" class="mt-16 scroll-mt-24" aria-labelledby="recs-h">
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
        <h2 id="recs-h" class="text-xl font-semibold">Recommendations</h2>
        <p class="text-sm text-muted">{recs.length} on LinkedIn, from managers and teammates, newest first.</p>
      </div>
      <ul class="rec-grid mt-6">
        {recs.map((r, i) => <li class:list={{ 'rec-grid__lead': i === 0 }}><Recommendation rec={r} size={i === 0 ? 'lg' : 'md'} /></li>)}
      </ul>
    </section>

    <section id="faq" class="mt-16 max-w-[70ch]" aria-labelledby="faq-h">
      <h2 id="faq-h" class="text-xl font-semibold">FAQ</h2>
      <div class="mt-6 divide-y divide-border border-y border-border">
        {profile.faq.map((f) => (
          <details class="group py-4">
            <summary class="cursor-pointer font-medium">{f.q}</summary>
            <p class="mt-2 text-muted">{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .rec-grid { list-style: none; padding: 0; display: grid; gap: 1.25rem; }
  @media (min-width: 768px) {
    .rec-grid { grid-template-columns: repeat(2, 1fr); }
    .rec-grid__lead { grid-column: 1 / -1; }
  }
</style>
