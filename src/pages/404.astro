---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="This page does not exist." path="/404" noindex twin={false}>
  <div class="container-page py-24">
    <h1 class="text-3xl font-semibold">Page not found</h1>
    <p class="mt-4 text-muted">The page you asked for doesn't exist. Try the <a href="/">home page</a> or <a href="/projects">projects</a>.</p>
  </div>
</BaseLayout>
