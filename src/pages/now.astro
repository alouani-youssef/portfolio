---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
const updated = new Date(`${profile.now.updated}T00:00:00Z`);
---
<BaseLayout title="Now" description="What Youssef Alouani is building and writing this month." path="/now">
  <div class="container-page py-12 sm:py-16">
    <div class="max-w-[70ch]">
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Now</h1>
      <p class="mt-2 text-sm text-muted">Updated <time datetime={profile.now.updated}>{updated.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}</time></p>
      <ul class="mt-8 list-disc space-y-3 pl-5">{profile.now.items.map((i) => <li>{i}</li>)}</ul>
    </div>
  </div>
</BaseLayout>
