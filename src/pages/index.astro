---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ExpertiseCards from '../components/ExpertiseCards.astro';
import ClientGroups from '../components/ClientGroups.astro';
import Recommendation from '../components/Recommendation.astro';
import { profile } from '../data/profile';
import { entrySlug } from '../lib/i18n';
import headshot from '../assets/media/headshot.png';

const [lead, rest] = profile.headline.split(/(?<=Osoul\.)\s/);
const recs = await getCollection('recommendations');
const pull = recs.find((r) => r.id === 'mohammad-al-ahmad')!;
const featured = (await getCollection('projects', (p) => p.data.featured && p.id.startsWith('en/'))).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('blog', (p) => p.id.startsWith('en/') && !p.data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
---
<BaseLayout title="Youssef Alouani · Lead Backend & AI Engineer" description={profile.oneLiner} path="/">
  <section class="container-page grid items-center gap-10 py-16 sm:py-24 md:grid-cols-[1fr_auto]">
    <div>
      <p class="eyebrow">Casablanca · Backend &amp; AI</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-5xl">{lead}</h1>
      <p class="mt-4 max-w-[48ch] text-lg text-muted sm:text-xl">{rest}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/contact" class="rounded-md bg-fg px-4 py-2 text-sm font-medium text-bg no-underline hover:opacity-90">Get in touch</a>
        <a href="/cv" class="rounded-md border border-border px-4 py-2 text-sm font-medium text-fg no-underline hover:border-accent">Read the CV</a>
      </div>
    </div>
    <Picture src={headshot} alt="Portrait of Youssef Alouani" widths={[160, 320]} sizes="160px" formats={['avif', 'webp']} class="h-40 w-40 rounded-full border border-border object-cover" loading="eager" />
  </section>

  <section class="container-page py-10" aria-labelledby="expertise">
    <h2 id="expertise" class="text-xl font-semibold">What I build</h2>
    <div class="mt-6"><ExpertiseCards /></div>
  </section>

  {featured.length > 0 && (
    <section class="container-page py-10" aria-labelledby="featured">
      <div class="flex items-baseline justify-between">
        <h2 id="featured" class="text-xl font-semibold">Featured case studies</h2>
        <a href="/projects" class="text-sm">All projects →</a>
      </div>
      <ul class="mt-6 grid gap-4 md:grid-cols-3">
        {featured.map((p) => (
          <li class="card featured-project">
            <p class="eyebrow">{p.data.kind === 'founder' ? 'Flagship' : p.data.area.toUpperCase()}</p>
            <h3 class="mt-2 font-semibold"><a href={`/projects/${entrySlug(p.id)}`} class="text-fg no-underline hover:text-accent">{p.data.title}</a></h3>
            <p class="mt-2 text-sm text-muted">{p.data.summary}</p>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="container-page grid gap-12 py-10 md:grid-cols-2">
    <ClientGroups />
    <div><Recommendation rec={pull} size="lg" /></div>
  </section>

  {posts.length > 0 && (
    <section class="container-page py-10" aria-labelledby="writing">
      <div class="flex items-baseline justify-between">
        <h2 id="writing" class="text-xl font-semibold">Latest writing</h2>
        <a href="/blog" class="text-sm">All posts →</a>
      </div>
      <ul class="mt-6 divide-y divide-border border-y border-border">
        {posts.map((p) => (
          <li class="flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:justify-between">
            <a href={p.data.external?.url ?? `/blog/${entrySlug(p.id)}`} class="font-medium">{p.data.title}</a>
            <span class="text-sm text-muted">{p.data.pubDate.toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' })}{p.data.external ? ' · on Medium' : ''}</span>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
