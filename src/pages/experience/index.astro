---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Timeline from '../../components/Timeline.astro';
import { getRoles } from '../../lib/experience';
import { profile } from '../../data/profile';
const roles = await getRoles();
const e = profile.education;
---
<BaseLayout title="Experience" description="Four roles and a side project over five years: Osoul, Axelerated Solutions, Finamaze, Qalqul Engine and 10xJobs, each with an AI thread." path="/experience">
  <div class="container-page py-12 sm:py-16">
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Experience</h1>
    <p class="mt-3 max-w-[70ch] text-muted">Four roles and a side project over five years, each with a clear AI thread.</p>
    <div class="mt-12"><Timeline roles={roles} /></div>
    <section class="mt-16 border-t border-border pt-8" aria-label="Education">
      <p class="eyebrow">Education</p>
      <p class="mt-2">{e.degree}, {e.school}, {e.start}–{e.end}</p>
    </section>
  </div>
</BaseLayout>
