---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import OssCard from '../components/OssCard.astro';
import { getOss } from '../lib/oss';
import { ossJsonLd } from '../lib/jsonld';
const oss = await getOss();
---
<BaseLayout title="Open source" description="Open-source projects by Youssef Alouani: AI Stones, archio, translator, a tracking kit and pg_inspector." path="/open-source" jsonLd={oss.map((o) => ossJsonLd(o.data))}>
  <div class="container-page py-12 sm:py-16">
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Open source</h1>
    <p class="mt-3 max-w-[70ch] text-muted">Tools I built in public, from a Claude Code setup generator to an MCP server for PostgreSQL.</p>

    <div class="oss-showcase mt-10" data-oss-showcase>
      <nav class="oss-nav" aria-label="Open-source projects">
        <ul>
          {oss.map((o) => (
            <li>
              <a href={`#${o.id}`} data-oss-tab={o.id}>
                <span class="oss-nav-logo"><Image src={o.data.logo} alt="" width={64} height={64} /></span>
                <span class="oss-nav-text">
                  <span class="oss-nav-name">{o.data.name}</span>
                  <span class="oss-nav-lang">{o.data.languages[0]}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="oss-panels space-y-6">
        {oss.map((entry) => <OssCard entry={entry} />)}
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Progressive enhancement: without JavaScript the nav is a list of jump links and every project shows.
  for (const root of document.querySelectorAll<HTMLElement>('[data-oss-showcase]')) {
    const tabs = [...root.querySelectorAll<HTMLAnchorElement>('[data-oss-tab]')];
    const panels = tabs.map((t) => document.getElementById(t.dataset.ossTab!)!);
    const list = root.querySelector('.oss-nav ul')!;
    list.setAttribute('role', 'tablist');
    list.setAttribute('aria-orientation', 'vertical');
    tabs.forEach((tab, i) => {
      tab.parentElement!.setAttribute('role', 'presentation');
      tab.setAttribute('role', 'tab');
      tab.id = `tab-${tab.dataset.ossTab}`;
      tab.setAttribute('aria-controls', panels[i].id);
      panels[i].setAttribute('role', 'tabpanel');
      panels[i].setAttribute('aria-labelledby', tab.id);
    });
    root.classList.add('is-enhanced');

    const select = (i: number, focus = false) => {
      tabs.forEach((tab, j) => {
        const on = i === j;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        panels[j].hidden = !on;
      });
      if (focus) tabs[i].focus();
      history.replaceState(null, '', `#${tabs[i].dataset.ossTab}`);
    };
    const fromHash = () => Math.max(0, tabs.findIndex((t) => `#${t.dataset.ossTab}` === location.hash));

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', (e) => { e.preventDefault(); select(i); });
      tab.addEventListener('keydown', (e) => {
        const next = { ArrowDown: i + 1, ArrowRight: i + 1, ArrowUp: i - 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 }[e.key];
        if (next === undefined) return;
        e.preventDefault();
        select((next + tabs.length) % tabs.length, true);
      });
    });
    window.addEventListener('hashchange', () => select(fromHash()));
    const start = fromHash();
    tabs.forEach((tab, j) => { tab.setAttribute('aria-selected', String(j === start)); tab.tabIndex = j === start ? 0 : -1; panels[j].hidden = j !== start; });
  }
</script>

<style>
  .oss-nav ul { list-style: none; padding: 0; margin: 0; display: flex; gap: 0.5rem; overflow-x: auto; padding-bottom: 0.25rem; }
  .oss-nav a {
    display: flex; align-items: center; gap: 0.625rem; padding: 0.5rem 0.75rem 0.5rem 0.5rem; border: 1px solid var(--border);
    border-radius: 0.75rem; color: var(--fg); text-decoration: none; white-space: nowrap; background: var(--bg);
  }
  .oss-nav a:hover { border-color: var(--accent); }
  .oss-nav a[aria-selected='true'] { border-color: var(--fg); box-shadow: inset 3px 0 0 var(--accent); background: var(--subtle); }
  .oss-nav-logo { flex: none; display: grid; place-items: center; width: 2.25rem; height: 2.25rem; overflow: hidden; border-radius: 0.5rem; background: #fff; border: 1px solid var(--border); }
  .oss-nav-logo img { width: 100%; height: 100%; object-fit: contain; }
  .oss-nav-text { display: flex; flex-direction: column; line-height: 1.2; }
  .oss-nav-name { font-weight: 600; font-size: 0.875rem; }
  .oss-nav-lang { font-family: var(--font-mono); font-size: 0.6875rem; color: var(--muted); }

  .oss-showcase { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
  @media (min-width: 1024px) {
    .oss-showcase { grid-template-columns: 15rem minmax(0, 1fr); align-items: start; }
    .oss-nav { position: sticky; top: 1.5rem; }
    .oss-nav ul { flex-direction: column; overflow: visible; }
    .oss-nav a { white-space: normal; }
  }
  /* Before the script runs (or without it), every panel shows in turn. */
  .oss-showcase:not(.is-enhanced) .oss-panels > :global(*) { scroll-margin-top: 1.5rem; }
</style>
