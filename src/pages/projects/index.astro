---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjectAreas, getChildren } from '../../lib/projects';
import { entrySlug } from '../../lib/i18n';
const areas = await getProjectAreas();
const withChildren = await Promise.all(
  areas.map(async (a) => ({ ...a, projects: await Promise.all(a.projects.map(async (p) => ({ p, children: await getChildren(p.id) }))) })),
);
const total = areas.reduce((n, a) => n + a.projects.length, 0);
const short = (t: string) => t.replace(/^.*?deep-dive:\s*/, '').replace(/^[^:]*:\s*/, '').replace(/^./, (c) => c.toUpperCase());
---
<BaseLayout title="Projects" description="Case studies in six areas: agentic systems, NLP/NLU, ML/DL and speech, recommendation systems, data pipelines and backend." path="/projects">
  <div class="container-page py-12 sm:py-16">
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Projects</h1>
    <p class="mt-3 max-w-[70ch] text-muted">{total} case studies in six areas, with deep dives inside each. Written at the architecture level: the problem, the design and the trade-offs, never client data.</p>
    <nav aria-label="Jump to area" class="mt-6 flex flex-wrap gap-2">
      {areas.map((a) => <a class="chip" href={`#${a.id}`}>{a.title} · {a.projects.length}</a>)}
    </nav>
    {withChildren.map((a) => (
      <section id={a.id} data-focus={a.id} class="mt-14 scroll-mt-20" aria-labelledby={`${a.id}-h`}>
        <h2 id={`${a.id}-h`} class="border-b border-border pb-4 text-xl font-semibold">{a.title}</h2>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {a.projects.map(({ p, children }) => (
            <li class="flex flex-col gap-3" data-parent={entrySlug(p.id)}>
              <ProjectCard project={p} />
              {children.length > 0 && (
                <div class="px-1 text-sm">
                  <p class="eyebrow">Deep dives</p>
                  <ul class="mt-1 space-y-1">
                    {children.map((c) => <li><a href={`/projects/${entrySlug(c.id)}`}>{short(c.data.title)}</a></li>)}
                  </ul>
                </div>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
