---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjectGroups } from '../../lib/projects';
import { entrySlug } from '../../lib/i18n';
const groups = await getProjectGroups();
const total = groups.reduce((n, g) => n + g.projects.length, 0);
const label = (g: (typeof groups)[number]) => g.role ? (g.role.data.alias ? `${g.role.data.alias.replace(/\s*AXS$/, '')} (${g.role.data.company})` : g.role.data.company) : 'Open source and independent';
---
<BaseLayout title="Projects" description="Case studies by company: Osoul, Sowtek, Finamaze, Qalqul, and open-source work." path="/projects">
  <div class="container-page py-12 sm:py-16">
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Projects</h1>
    <p class="mt-3 max-w-[70ch] text-muted">{total} case studies, grouped by where I built them. Written at the architecture level: the problem, the design and the trade-offs, never client data.</p>
    <nav aria-label="Jump to company" class="mt-6 flex flex-wrap gap-2">
      {groups.map((g) => <a class="chip" href={`#${g.anchor}`}>{label(g)} · {g.projects.length}</a>)}
    </nav>
    {groups.map((g) => (
      <section id={g.anchor} class="mt-14 scroll-mt-20" aria-labelledby={`${g.anchor}-h`}>
        <div class="flex flex-wrap items-center gap-4 border-b border-border pb-4">
          {g.role && <Image src={g.role.data.logo} alt="" width={96} height={96} class="h-12 w-12 flex-none rounded-xl border border-border bg-white object-contain" />}
          <div class="min-w-0 flex-1">
            <h2 id={`${g.anchor}-h`} class="text-xl font-semibold">{label(g)}</h2>
            {g.role && <p class="text-sm text-muted">{g.role.data.role} · {g.role.data.period}</p>}
          </div>
          {g.role ? <a href={`/experience/${entrySlug(g.role.id)}`} class="text-sm">Role details →</a> : <a href="/open-source" class="text-sm">All open source →</a>}
        </div>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {g.projects.map((p) => <li><ProjectCard project={p} /></li>)}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
