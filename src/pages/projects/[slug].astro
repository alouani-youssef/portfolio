---
import { render, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MetricList from '../../components/MetricList.astro';
import StackChips from '../../components/StackChips.astro';
import Figure from '../../components/Figure.astro';
import { getProjects } from '../../lib/projects';
import { entrySlug } from '../../lib/i18n';
import { isPreview, placeholderViolations } from '../../lib/metrics';
import { publishedCheckMarkers } from '../../lib/check-markers';
import { projectJsonLd } from '../../lib/jsonld';

export async function getStaticPaths() {
  const projects = await getProjects();
  const violations = placeholderViolations(projects);
  if (!isPreview() && violations.length > 0) {
    throw new Error(`Placeholder metrics in production build:\n${violations.join('\n')}`);
  }
  const unconfirmed = publishedCheckMarkers();
  if (unconfirmed.length > 0) {
    const msg = `Unconfirmed claims (CHECK markers): ${unconfirmed.length}\n${unconfirmed.join('\n')}`;
    if (!isPreview()) throw new Error(msg);
    console.warn(`[preview] ${unconfirmed.length} CHECK markers left; production builds will fail. See docs/review/claims-to-confirm.md`);
  }
  return projects.map((project) => ({ params: { slug: entrySlug(project.id) }, props: { project } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;
const path = `/projects/${entrySlug(project.id)}`;
const company = d.company ? await getEntry(d.company) : undefined;
const preview = isPreview();
const parent = d.parent ? await getEntry(d.parent) : undefined;
const children = (await getProjects()).filter((p) => p.data.parent?.id === project.id);
---
<BaseLayout title={d.title} description={d.summary} path={path} jsonLd={[projectJsonLd(d, `${Astro.site!.origin}${path}`)]}>
  <article class="container-page py-12 sm:py-16">
    {parent ? <a href={`/projects/${entrySlug(parent.id)}`} class="text-sm">← {parent.data.title}</a> : <a href="/projects" class="text-sm">← Projects</a>}
    <header class="mt-6 max-w-[70ch]">
      <p class="eyebrow">{parent ? 'Deep dive · ' : d.kind === 'founder' ? 'Flagship · ' : ''}{company ? company.data.company : 'Independent'} · {d.status}</p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">{d.title}</h1>
      <p class="mt-4 text-lg text-muted">{d.summary}</p>
    </header>
    {d.media.length === 0 && <div class="mt-8 max-w-[72ch]"><Figure src={d.cover} alt={d.coverAlt} caption="" /></div>}
    <div class="case-body mt-10 max-w-[72ch] space-y-4 [&_h2]:mt-12 [&_h2]:text-xl [&_h2]:font-semibold [&_h3]:mt-6 [&_h3]:font-semibold [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:list-decimal [&_ol]:pl-5 [&_li]:mt-1">
      <Content media={d.media} />
      <h2>Results</h2>
      <MetricList metrics={d.metrics} preview={preview} />
      <h2>Stack and links</h2>
      {children.length > 0 && (
        <div>
          <h3>Deep dives</h3>
          <ul>{children.map((c) => <li><a href={`/projects/${entrySlug(c.id)}`}>{((t) => t.charAt(0).toUpperCase() + t.slice(1))(c.data.title.replace(/^.*deep-dive:\s*/, ''))}</a>: {c.data.summary}</li>)}</ul>
        </div>
      )}
      <StackChips skills={d.skills} />
      <ul class="!list-none !pl-0 flex flex-wrap gap-x-6 gap-y-2 text-sm">
        {d.links.repo && <li><a href={d.links.repo}>Repository</a></li>}
        {d.links.demo && <li><a href={d.links.demo}>Live product</a></li>}
        {d.links.post && <li><a href={d.links.post}>Related post</a></li>}
        {company && <li><a href={`/experience/${entrySlug(company.id)}`}>Role at {company.data.company}</a></li>}
      </ul>
    </div>
  </article>
</BaseLayout>
