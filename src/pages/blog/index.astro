---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts } from '../../lib/post-queries';
import { entrySlug } from '../../lib/i18n';
const posts = await getPosts(true);
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---
<BaseLayout title="Blog" description="Writing on backend architecture, RAG, MCP and speech-to-text, plus earlier posts on Medium." path="/blog">
  <div class="container-page py-12 sm:py-16">
    <div class="max-w-[70ch]">
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Blog</h1>
      <p class="mt-3 text-muted">New writing lives here first. Earlier posts are on Medium and marked as such. <a href="/rss.xml">RSS</a></p>
      <nav aria-label="Tags" class="mt-6 flex flex-wrap gap-2">
        {tags.map((t) => <a class="chip" href={`/blog/tags/${t}`}>{t}</a>)}
      </nav>
      <ul class="mt-10 divide-y divide-border border-y border-border">
        {posts.map((p) => (
          <li class="py-5">
            <a href={p.data.external?.url ?? `/blog/${entrySlug(p.id)}`} class="text-lg font-medium">{p.data.title}</a>
            <p class="mt-1 text-sm text-muted">
              <time datetime={p.data.pubDate.toISOString().slice(0, 10)}>{fmt(p.data.pubDate)}</time>
              {p.data.external && <span> · on Medium</span>}
              {p.data.draft && <span class="badge">draft</span>}
            </p>
            <p class="mt-2 text-muted">{p.data.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</BaseLayout>
