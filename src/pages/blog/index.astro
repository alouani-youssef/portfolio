---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/blog/PostCard.astro';
import SkillIcon from '../../components/SkillIcon.astro';
import { getPosts, getUpcomingPosts } from '../../lib/post-queries';
import { tagCounts, tagMeta } from '../../lib/tags';
const posts = await getPosts(false);
const upcoming = await getUpcomingPosts();
const tags = tagCounts(posts);
---
<BaseLayout title="Blog" description="Writing on backend architecture, RAG, MCP and speech-to-text, plus earlier posts on Medium." path="/blog">
  <div class="container-page py-12 sm:py-16" data-blog-filter>
    <header class="max-w-[70ch]">
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Blog</h1>
      <p class="mt-3 text-muted">New writing lives here first. Earlier posts are on Medium and marked as such. <a href="/rss.xml">RSS</a></p>
    </header>

    <nav aria-label="Tags" class="tag-bar mt-8">
      <a class="chip tag-filter" href="/blog" data-filter="all" aria-current="page">All <span class="tag-chip__count">{posts.length}</span></a>
      {tags.map(({ id, count }) => {
        const m = tagMeta(id);
        return (
          <a class="chip tag-chip tag-filter" href={`/blog/tags/${id}`} data-filter={id} style={`--h: ${m.hue}`} title={m.blurb}>
            <SkillIcon icon={m.icon} /><span>{m.label}</span><span class="tag-chip__count">{count}</span>
          </a>
        );
      })}
    </nav>
    <p class="tag-blurb mt-3 min-h-6 text-sm text-muted" role="status" aria-live="polite"></p>

    <ul class="post-grid mt-6">
      {posts.map((p, i) => (
        <li data-tags={p.data.tags.join(' ')} class:list={{ 'post-grid__lead': i === 0 }}>
          <PostCard post={p} featured={i === 0} />
        </li>
      ))}
    </ul>

    {upcoming.length > 0 && (
      <section class="mt-14" aria-labelledby="upcoming-h" data-upcoming>
        <h2 id="upcoming-h" class="text-xl font-semibold">Coming soon</h2>
        <ul class="upcoming-grid mt-6">
          {upcoming.map((p) => <li><PostCard post={p} /></li>)}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>

<script>
  /** Progressive enhancement: tag links filter in place and keep ?tag= in the URL; without JS they open tag pages. */
  for (const root of document.querySelectorAll<HTMLElement>('[data-blog-filter]')) {
    const links = [...root.querySelectorAll<HTMLAnchorElement>('.tag-filter')];
    const items = [...root.querySelectorAll<HTMLElement>('.post-grid > li')];
    const status = root.querySelector<HTMLElement>('.tag-blurb')!;
    const known = new Set(links.map((a) => a.dataset.filter));

    const apply = (filter: string, push: boolean) => {
      if (!known.has(filter)) filter = 'all';
      let shown = 0;
      for (const a of links) {
        if (a.dataset.filter === filter) a.setAttribute('aria-current', 'page');
        else a.removeAttribute('aria-current');
      }
      for (const li of items) {
        li.hidden = filter !== 'all' && !li.dataset.tags!.split(' ').includes(filter);
        if (!li.hidden) shown++;
      }
      root.classList.toggle('is-filtered', filter !== 'all');
      const active = links.find((a) => a.dataset.filter === filter)!;
      status.textContent = filter === 'all' ? '' : `${shown} post${shown === 1 ? '' : 's'} · ${active.title}`;
      if (push) {
        const url = new URL(location.href);
        if (filter === 'all') url.searchParams.delete('tag'); else url.searchParams.set('tag', filter);
        history.replaceState(null, '', url);
      }
    };

    root.querySelector<HTMLElement>('.tag-bar')!.addEventListener('click', (e: MouseEvent) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('.tag-filter');
      if (!a || e.metaKey || e.ctrlKey || e.shiftKey || e.button === 1) return;
      e.preventDefault();
      apply(a.getAttribute('aria-current') && a.dataset.filter !== 'all' ? 'all' : a.dataset.filter!, true);
    });
    apply(new URL(location.href).searchParams.get('tag') ?? 'all', false);
  }
</script>

<style>
  .tag-bar { display: flex; gap: 0.5rem; overflow-x: auto; padding-bottom: 0.25rem; scrollbar-width: thin; }
  @media (min-width: 768px) { .tag-bar { flex-wrap: wrap; overflow: visible; } }
  .tag-filter { flex: none; padding-block: 0.3125rem; }
  .tag-filter[data-filter='all'][aria-current] { background: var(--fg); border-color: var(--fg); color: var(--bg); }
  .tag-filter[data-filter='all'][aria-current] .tag-chip__count { color: inherit; opacity: 0.7; }
  .post-grid, .upcoming-grid { list-style: none; padding: 0; display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); }
  .post-grid__lead { grid-column: 1 / -1; }
  /* While filtering, the lead card drops back into the grid like the others. */
  .is-filtered .post-grid__lead { grid-column: auto; }
  .is-filtered .post-grid__lead :global(.post-card--featured) { flex-direction: column; }
  .is-filtered .post-grid__lead :global(.post-card--featured > .post-cover) { flex: none; aspect-ratio: 1200 / 630; min-height: 0; }
  .is-filtered .post-grid__lead :global(.post-card--featured .post-card__title) { font-size: 1.0625rem; }
  .is-filtered .post-grid__lead :global(.post-card--featured .post-card__body) { padding: 1rem 1.125rem 1.125rem; justify-content: flex-start; }
</style>
