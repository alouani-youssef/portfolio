---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import TagChip from '../../../components/blog/TagChip.astro';
import SkillIcon from '../../../components/SkillIcon.astro';
import { getPosts } from '../../../lib/post-queries';
import { tagCounts, tagMeta } from '../../../lib/tags';
export async function getStaticPaths() {
  const posts = await getPosts(true);
  const all = tagCounts(posts);
  return all.map(({ id }) => ({
    params: { tag: id },
    props: { tag: id, posts: posts.filter((p) => p.data.tags.includes(id)), others: all.filter((t) => t.id !== id) },
  }));
}
const { tag, posts, others } = Astro.props;
const m = tagMeta(tag);
---
<BaseLayout title={`Writing on ${m.label}`} description={`${m.blurb} Posts by Youssef Alouani tagged ${m.label}.`} path={`/blog/tags/${tag}`} twin={false} noindex>
  <div class="container-page py-12 sm:py-16">
    <a href="/blog" class="text-sm">← All posts</a>
    <header class="tag-hero mt-6" style={`--h: ${m.hue}`}>
      <span class="tag-hero__icon"><SkillIcon icon={m.icon} /></span>
      <div>
        <p class="eyebrow">Tag · {posts.length} post{posts.length === 1 ? '' : 's'}</p>
        <h1 class="mt-1 text-3xl font-semibold tracking-tight sm:text-4xl">{m.label}</h1>
        <p class="mt-2 text-muted">{m.blurb}</p>
      </div>
    </header>
    <ul class="post-grid mt-10">
      {posts.map((p) => <li><PostCard post={p} currentTag={tag} /></li>)}
    </ul>
    {others.length > 0 && (
      <nav aria-labelledby="other-tags" class="mt-14">
        <h2 id="other-tags" class="eyebrow">Other tags</h2>
        <ul class="mt-3 flex flex-wrap gap-2">{others.map((t) => <li><TagChip tag={t.id} count={t.count} /></li>)}</ul>
      </nav>
    )}
  </div>
</BaseLayout>

<style>
  .tag-hero { --tag: oklch(47% 0.13 var(--h)); display: flex; align-items: center; gap: 1.25rem; }
  :global(:root[data-theme='dark']) .tag-hero { --tag: oklch(80% 0.1 var(--h)); }
  .tag-hero__icon {
    flex: none; display: grid; place-items: center; width: 4rem; height: 4rem; border-radius: 1rem; color: var(--tag);
    background: color-mix(in oklch, var(--tag) 12%, transparent); border: 1px solid color-mix(in oklch, var(--tag) 30%, transparent);
  }
  .tag-hero__icon :global(.skill-icon) { width: 1.75rem; height: 1.75rem; }
  .post-grid { list-style: none; padding: 0; display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); }
</style>
