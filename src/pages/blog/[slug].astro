---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCover from '../../components/blog/PostCover.astro';
import PostCard from '../../components/blog/PostCard.astro';
import TagChip from '../../components/blog/TagChip.astro';
import { getPosts } from '../../lib/post-queries';
import { entrySlug } from '../../lib/i18n';
import { blogPostingJsonLd } from '../../lib/jsonld';
import { readingMinutes, relatedByTags } from '../../lib/tags';
export async function getStaticPaths() {
  const all = await getPosts(true);
  return all.filter((p) => !p.data.external).map((post) => ({ params: { slug: entrySlug(post.id) }, props: { post, related: relatedByTags(post, all) } }));
}
const { post, related } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const slug = entrySlug(post.id);
const minutes = readingMinutes(post.body ?? '');
---
<BaseLayout title={d.title} description={d.description} path={`/blog/${slug}`} noindex={d.draft} twin={!d.draft} jsonLd={[blogPostingJsonLd(d, `${Astro.site!.origin}/blog/${slug}`)]}>
  <article class="container-page py-12 sm:py-16">
    <div class="mx-auto max-w-[70ch]">
      <a href="/blog" class="text-sm">← Blog</a>
      <header class="mt-6">
        <ul class="flex flex-wrap gap-2" aria-label="Tags">{d.tags.map((t) => <li><TagChip tag={t} /></li>)}</ul>
        <h1 class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl">{d.title}</h1>
        <p class="mt-4 text-lg text-muted">{d.description}</p>
        <p class="eyebrow mt-5">
          <time datetime={d.pubDate.toISOString().slice(0, 10)}>{d.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}</time>
          <span> · {minutes} min read</span>
          {d.draft && <span class="badge">draft</span>}
        </p>
      </header>
    </div>
    <div class="mx-auto mt-8 max-w-[56rem]">
      <PostCover slug={slug} tags={d.tags} cover={d.cover} size="hero" eager />
    </div>
    <div class="mx-auto max-w-[70ch]">
      <div class="post-body mt-10 space-y-4 [&_h2]:mt-10 [&_h2]:text-xl [&_h2]:font-semibold [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:list-decimal [&_ol]:pl-5 [&_li]:mt-1">
        <Content />
      </div>
      <footer class="mt-12 border-t border-border pt-6">
        <p class="eyebrow">Filed under</p>
        <ul class="mt-3 flex flex-wrap gap-2">{d.tags.map((t) => <li><TagChip tag={t} /></li>)}</ul>
      </footer>
    </div>
    {related.length > 0 && (
      <aside aria-labelledby="related-h" class="mx-auto mt-16 max-w-[56rem]">
        <h2 id="related-h" class="text-xl font-semibold">Keep reading</h2>
        <ul class="related-grid mt-6">{related.map((p) => <li><PostCard post={p} headingLevel="h3" /></li>)}</ul>
      </aside>
    )}
  </article>
</BaseLayout>

<style>
  .related-grid { list-style: none; padding: 0; display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr)); }
</style>
