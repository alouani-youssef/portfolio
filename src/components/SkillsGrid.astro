---
import { getCollection } from 'astro:content';
import SkillIcon from './SkillIcon.astro';
import { SKILL_CATEGORIES, LEVEL_LABELS } from '../lib/skill-icons';
import { entrySlug } from '../lib/i18n';
const skills = await getCollection('skills');
const projects = new Set((await getCollection('projects', (p) => p.id.startsWith('en/'))).map((p) => entrySlug(p.id)));
const roles = new Set((await getCollection('experience', (e) => e.id.startsWith('en/'))).map((e) => entrySlug(e.id)));
/** Each skill links to its first (strongest) piece of evidence: a case study, a role or an open-source entry. */
const evidenceHref = (id: string) => (projects.has(id) ? `/projects/${id}` : roles.has(id) ? `/experience/${id}` : `/open-source#${id}`);
const DOT = { expert: '●', production: '◦', familiar: '·' } as const;
const levels = Object.keys(LEVEL_LABELS) as Array<keyof typeof LEVEL_LABELS>;
---
<p class="skill-legend flex flex-wrap gap-x-4 gap-y-1 text-xs text-muted">
  {levels.map((l) => <span><span aria-hidden="true">{DOT[l]}</span> {LEVEL_LABELS[l]}</span>)}
</p>
<ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {SKILL_CATEGORIES.map((c) => (
    <li class="skill-group card">
      <h3 class="flex items-center gap-2 font-semibold">
        <SkillIcon icon={c.icon} class="text-accent" />
        {c.label}
      </h3>
      <ul class="mt-3 flex flex-wrap gap-2">
        {skills.filter((s) => s.data.category === c.id).map((s) => (
          <li id={`skill-${s.id}`} class="skill">
            <a href={evidenceHref(s.data.evidence[0])} class="chip inline-flex items-center gap-1.5">
              <SkillIcon icon={s.data.icon} />
              {s.data.name}
              <span class="text-muted" aria-hidden="true">{DOT[s.data.level]}</span>
              <span class="sr-only">({LEVEL_LABELS[s.data.level]})</span>
            </a>
          </li>
        ))}
      </ul>
    </li>
  ))}
</ul>
