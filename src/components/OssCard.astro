---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import AiStonesDiagram from './diagrams/AiStonesDiagram.astro';
import ArchioDiagram from './diagrams/ArchioDiagram.astro';
import TranslatorDiagram from './diagrams/TranslatorDiagram.astro';
import TrackingKitDiagram from './diagrams/TrackingKitDiagram.astro';
import PgInspectorDiagram from './diagrams/PgInspectorDiagram.astro';
interface Props { entry: CollectionEntry<'oss'> }
const { entry } = Astro.props;
const d = entry.data;
/** One architecture diagram per project; a missing one fails the build. */
const DIAGRAMS = {
  'ai-stones': AiStonesDiagram,
  archio: ArchioDiagram,
  translator: TranslatorDiagram,
  'tracking-kit': TrackingKitDiagram,
  'pg-inspector': PgInspectorDiagram,
} as const;
const Diagram = DIAGRAMS[entry.id as keyof typeof DIAGRAMS];
if (!Diagram) throw new Error(`No architecture diagram for open-source entry "${entry.id}"`);
---
<article id={entry.id} class="oss-card card scroll-mt-24" aria-labelledby={`${entry.id}-h`}>
  <header class="flex items-start gap-4">
    <span class="oss-logo"><Image src={d.logo} alt={`${d.name} logo`} width={112} height={112} /></span>
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
        <h2 id={`${entry.id}-h`} class="text-xl font-semibold">{d.name}</h2>
        {d.status && <span class="oss-status">{d.status}</span>}
      </div>
      <p class="mt-1 text-muted">{d.pitch}</p>
      <ul class="mt-3 flex flex-wrap gap-2" aria-label="Languages and licence">
        {d.languages.map((l) => <li class="chip">{l}</li>)}
        <li class="chip license" title="Licence">{d.license}</li>
      </ul>
    </div>
  </header>

  <div class="oss-media mt-6 space-y-4">
    {d.media.map((m) => (
      <Image src={m.src} alt={m.alt} widths={[480, 960, 1440]} sizes="(min-width: 1024px) 760px, 100vw" class="mx-auto max-h-80 w-full rounded-lg border border-border bg-white object-contain" />
    ))}
    <Diagram />
  </div>

  <ul class="mt-6 list-disc space-y-1 pl-5 text-sm">
    {d.highlights.map((h) => <li>{h}</li>)}
  </ul>
  <ul class="mt-5 flex flex-wrap gap-2 text-sm">
    {d.repos.map((r) => <li><a class="oss-link" href={r.url}>{d.repos.length > 1 ? `${r.label} on GitHub` : 'Repository on GitHub'}</a></li>)}
    {d.links.map((l) => <li><a class="oss-link" href={l.url}>{l.label}</a></li>)}
    {d.related && <li><a class="oss-link" href={`/projects/${d.related.id.replace(/^en\//, '')}`}>Case study →</a></li>}
  </ul>
</article>

<style>
  .oss-logo { flex: none; display: grid; place-items: center; width: 3.5rem; height: 3.5rem; overflow: hidden; border-radius: 0.875rem; border: 1px solid var(--border); background: #fff; }
  .oss-logo img { width: 100%; height: 100%; object-fit: contain; }
  .oss-status {
    font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 500; letter-spacing: 0.04em; text-transform: uppercase;
    color: #0f6b3a; background: #e3f5ea; border: 1px solid #b7e2c6; border-radius: 999px; padding: 0.0625rem 0.5rem;
  }
  :global(:root[data-theme='dark']) .oss-status { color: #8fe0b0; background: #10261a; border-color: #1f4a32; }
  .oss-link { display: inline-block; border: 1px solid var(--border); border-radius: 999px; padding: 0.25rem 0.75rem; text-decoration: none; }
  .oss-link:hover { border-color: var(--accent); }
</style>
