---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { entrySlug } from '../lib/i18n';
import { projectThumb } from '../lib/projects';
interface Props { project: CollectionEntry<'projects'>; eyebrow?: string }
const { project: p, eyebrow } = Astro.props;
const thumb = projectThumb(p);
const label = eyebrow ?? (p.data.parent ? 'Deep dive' : p.data.kind === 'founder' ? 'Flagship' : p.data.area === 'ai' ? 'AI' : p.data.area.charAt(0).toUpperCase() + p.data.area.slice(1));
const title = p.data.title.replace(/^.*deep-dive:\s*/, '').replace(/^./, (c) => c.toUpperCase());
---
<a href={`/projects/${entrySlug(p.id)}`} class="card project-card flex h-full flex-col overflow-hidden !p-0 no-underline hover:border-accent">
  <div class="aspect-[16/9] overflow-hidden border-b border-border bg-subtle">
    <Picture src={thumb.src} alt={thumb.alt} widths={[400, 800]} sizes="(min-width: 768px) 360px, 100vw" formats={['avif', 'webp']} class="h-full w-full object-cover object-top" loading="lazy" />
  </div>
  <div class="flex flex-1 flex-col p-5">
    <p class="eyebrow">{label}</p>
    <h3 class="mt-2 font-semibold text-fg">{title}</h3>
    <p class="mt-2 text-sm text-muted">{p.data.summary}</p>
  </div>
</a>
