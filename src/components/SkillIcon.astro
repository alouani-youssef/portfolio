---
import { resolveIcon } from '../lib/skill-icons';
interface Props { icon: string; class?: string }
const { icon, class: className } = Astro.props;
const { svg, brand, brandHover } = resolveIcon(icon);
---
<span
  class:list={['skill-icon', brand ? 'skill-icon--brand' : 'skill-icon--concept', className]}
  style={brandHover ? `--brand: ${brandHover}` : undefined}
  set:html={svg}
/>
