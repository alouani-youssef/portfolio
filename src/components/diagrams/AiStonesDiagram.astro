---
import LayerDiagram from './LayerDiagram.astro';
---
<LayerDiagram
  title="AI Stones: from project to Claude Code setup"
  desc="ai-stones init detects the stack (languages, frameworks, package manager, commands, conventions), asks for the context it cannot infer, then installs only the selected setup: AGENT.md and CLAUDE.md, .mcp.json, and .claude/ with settings, hooks, skills, commands and tools. stones.json records answers and file hashes so re-runs update unedited files and preserve edited ones."
  layers={[
    { caption: 'Input', nodes: [{ label: 'Your repository', sub: 'manifests · configs · git history' }] },
    { caption: 'Detect', nodes: [{ label: 'Stack detection', sub: 'languages · frameworks · commands', accent: true }, { label: 'Conventions', sub: 'formatters · commit style' }] },
    { caption: 'Ask', nodes: [{ label: 'Project interview', sub: 'detected values become defaults' }] },
    { caption: 'Install', nodes: [{ label: 'AGENT.md', sub: 'imported by CLAUDE.md' }, { label: '.claude/', sub: 'hooks · skills · tools' }, { label: '.mcp.json' }] },
  ]}
  side={{ label: 'stones.json', sub: 'answers · file hashes', layer: 3 }}
>
  <slot />
</LayerDiagram>
