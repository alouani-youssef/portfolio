---
import ThemeToggle from './ThemeToggle.astro';
interface Props { path: string }
const { path } = Astro.props;
const nav = [
  { href: '/experience', label: 'Experience' },
  { href: '/projects', label: 'Projects' },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---
<header class="border-b border-border">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href="/" class="font-semibold text-fg no-underline">Youssef Alouani</a>
    <nav aria-label="Main" class="flex items-center gap-1 sm:gap-2">
      <ul class="hidden items-center gap-1 md:flex">
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={['rounded-md px-3 py-2 text-sm no-underline', isActive(item.href) ? 'text-accent' : 'text-muted hover:text-fg']}>{item.label}</a>
          </li>
        ))}
      </ul>
      <details class="relative md:hidden">
        <summary class="cursor-pointer list-none rounded-md border border-border px-3 py-1.5 text-sm text-fg">Menu</summary>
        <ul class="absolute right-0 z-20 mt-2 w-44 rounded-md border border-border bg-bg p-2">
          {nav.map((item) => (<li><a href={item.href} class="block rounded px-3 py-2 text-sm text-fg no-underline hover:bg-subtle">{item.label}</a></li>))}
        </ul>
      </details>
      <slot name="actions" />
      <ThemeToggle />
    </nav>
  </div>
</header>
