---
import { getCollection } from 'astro:content';
import ClientTile from './ClientTile.astro';
import { groupClients, GROUP_SHORT_LABELS } from '../lib/clients';
interface Props { experienceId?: string; heading?: string; headingLevel?: 'h2' | 'h3' }
const { experienceId, heading = 'Clients I have worked for', headingLevel = 'h2' } = Astro.props;
const all = await getCollection('clients');
const filtered = all.filter((c) => !experienceId || c.data.experience.id === experienceId).map((c) => c.data);
const groups = groupClients(filtered);
const H = headingLevel;
const Sub = headingLevel === 'h2' ? 'h3' : 'h4';
/** The full list gets group filters; a role's short list stays grouped under headings. */
const filterable = !experienceId;
const total = groups.reduce((n, g) => n + g.clients.length, 0);
---
{groups.length > 0 && (
  filterable ? (
    <section aria-labelledby="clients-h" class="client-groups" data-client-filter>
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-3">
        <H id="clients-h" class="text-xl font-semibold">{heading}</H>
        <div class="client-filter flex flex-wrap gap-2" role="group" aria-label="Filter clients by group" hidden>
          <button type="button" class="chip" data-filter="all" aria-pressed="true">All <span class="text-muted">{total}</span></button>
          {groups.map((g) => (
            <button type="button" class="chip" data-filter={g.group} aria-pressed="false" title={g.label}>
              {GROUP_SHORT_LABELS[g.group]} <span class="text-muted">{g.clients.length}</span>
            </button>
          ))}
        </div>
      </div>
      <p class="sr-only" role="status"></p>
      <ul class="client-grid mt-6">
        {groups.flatMap((g) => g.clients.map((c) => <li data-group={g.group}><ClientTile client={c} /></li>))}
      </ul>
    </section>
  ) : (
    <section aria-label={heading} class="client-groups">
      <H class="text-lg font-semibold">{heading}</H>
      <div class="mt-6 grid gap-8 md:grid-cols-2">
        {groups.map((g) => (
          <div>
            <Sub class="eyebrow">{g.label}</Sub>
            <ul class="client-grid mt-3">{g.clients.map((c) => <li><ClientTile client={c} /></li>)}</ul>
          </div>
        ))}
      </div>
    </section>
  )
)}

<script>
  for (const section of document.querySelectorAll<HTMLElement>('[data-client-filter]')) {
    const bar = section.querySelector<HTMLElement>('.client-filter')!;
    const buttons = [...bar.querySelectorAll<HTMLButtonElement>('button')];
    const items = [...section.querySelectorAll<HTMLElement>('li[data-group]')];
    const status = section.querySelector<HTMLElement>('[role="status"]')!;
    bar.hidden = false;
    bar.addEventListener('click', (e) => {
      const picked = (e.target as HTMLElement).closest('button');
      if (!picked) return;
      const filter = picked.dataset.filter;
      for (const b of buttons) b.setAttribute('aria-pressed', String(b === picked));
      let shown = 0;
      for (const li of items) {
        li.hidden = filter !== 'all' && li.dataset.group !== filter;
        if (!li.hidden) shown++;
      }
      status.textContent = `Showing ${shown} client${shown === 1 ? '' : 's'}`;
    });
  }
</script>

<style>
  .client-grid { list-style: none; padding: 0; display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr)); }
  .client-filter button { cursor: pointer; font-size: 0.75rem; padding: 0.25rem 0.75rem; }
  .client-filter button:hover { border-color: var(--accent); }
  .client-filter button[aria-pressed='true'] { background: var(--fg); border-color: var(--fg); color: var(--bg); }
  .client-filter button[aria-pressed='true'] .text-muted { color: inherit; opacity: 0.7; }
</style>
