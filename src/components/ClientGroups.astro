---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { groupClients } from '../lib/clients';
interface Props { experienceId?: string; heading?: string; headingLevel?: 'h2' | 'h3' }
const { experienceId, heading = 'Clients I have worked for', headingLevel = 'h2' } = Astro.props;
const all = await getCollection('clients');
const filtered = all.filter((c) => !experienceId || c.data.experience.id === experienceId).map((c) => c.data);
const groups = groupClients(filtered);
const H = headingLevel;
const Sub = headingLevel === 'h2' ? 'h3' : 'h4';
/** Short name for the tile: drops the parenthesised expansion, e.g. "Saudi National Bank (SNB)" → "Saudi National Bank". */
const short = (name: string) => name.replace(/\s*\(.*\)$/, '');
---
{groups.length > 0 && (
  <section aria-label={heading} class="client-groups">
    <H class={headingLevel === 'h2' ? 'text-xl font-semibold' : 'text-lg font-semibold'}>{heading}</H>
    <div class="mt-6 grid gap-x-8 gap-y-8 md:grid-cols-2">
      {groups.map((g) => (
        <div>
          <Sub class="eyebrow">{g.label}</Sub>
          <ul class="client-grid mt-3">
            {g.clients.map((c) => {
              const Tile = c.url ? 'a' : 'div';
              const link = c.url ? { href: c.url, target: '_blank', rel: 'noopener noreferrer' } : {};
              return (
                <li>
                  <Tile class:list={['client-tile', c.logoBg === 'dark' && 'client-tile--dark']} {...link} title={c.name}>
                    <span class="client-logo">
                      {c.logo
                        ? <Image src={c.logo} alt={`${short(c.name)} logo`} height={96} width={Math.round((96 * c.logo.width) / c.logo.height)} />
                        : <span class="client-wordmark" aria-hidden="true">{short(c.name)}</span>}
                    </span>
                    <span class="client-name">{short(c.name)}{c.url && <span class="client-out" aria-hidden="true">↗</span>}</span>
                    <span class="client-market">{c.market}</span>
                  </Tile>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>
  </section>
)}

<style>
  .client-grid { list-style: none; padding: 0; display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr)); }
  .client-tile {
    display: flex; flex-direction: column; height: 100%; border: 1px solid var(--border); border-radius: 0.75rem;
    padding: 0.5rem; color: var(--fg); text-decoration: none; background: var(--bg);
  }
  a.client-tile:hover, a.client-tile:focus-visible { border-color: var(--accent); }
  .client-logo { display: flex; align-items: center; justify-content: center; box-sizing: border-box; height: 4rem; padding: 0.625rem 0.75rem; border-radius: 0.5rem; background: #fff; }
  .client-tile--dark .client-logo { background: #1b2a3a; }
  /* Fill the box's height, never its width: object-fit keeps the logo's proportions either way. */
  .client-logo img { height: 100%; width: auto; max-width: 100%; object-fit: contain; }
  .client-wordmark { font-weight: 600; font-size: 0.875rem; line-height: 1.2; text-align: center; color: #111214; }
  .client-name { margin-top: 0.5rem; padding-inline: 0.25rem; font-size: 0.8125rem; font-weight: 500; line-height: 1.3; }
  .client-out { margin-left: 0.25rem; color: var(--muted); }
  .client-market { padding-inline: 0.25rem; font-family: var(--font-mono); font-size: 0.6875rem; color: var(--muted); }
</style>
