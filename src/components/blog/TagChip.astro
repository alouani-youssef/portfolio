---
import SkillIcon from '../SkillIcon.astro';
import { tagMeta } from '../../lib/tags';
interface Props { tag: string; count?: number; current?: boolean }
const { tag, count, current = false } = Astro.props;
const m = tagMeta(tag);
---
<a
  class="chip tag-chip"
  href={`/blog/tags/${tag}`}
  style={`--h: ${m.hue}`}
  title={m.blurb}
  aria-current={current ? 'page' : undefined}
><SkillIcon icon={m.icon} class="tag-chip__icon" /><span>{m.label}</span>{count !== undefined && <span class="tag-chip__count">{count}</span>}</a>
