---
import type { CollectionEntry } from 'astro:content';
import PostCover from './PostCover.astro';
import TagChip from './TagChip.astro';
import { entrySlug } from '../../lib/i18n';
import { readingMinutes } from '../../lib/tags';
interface Props { post: CollectionEntry<'blog'>; featured?: boolean; headingLevel?: 'h2' | 'h3'; currentTag?: string }
const { post, featured = false, headingLevel = 'h2', currentTag } = Astro.props;
const d = post.data;
const slug = entrySlug(post.id);
const href = d.external?.url ?? `/blog/${slug}`;
const H = headingLevel;
const date = d.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const minutes = d.external ? null : readingMinutes(post.body ?? '');
const plural = (n: number, w: string) => `${n} ${w}${n === 1 ? '' : 's'}`;
const asOf = d.stats?.asOf.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<article class:list={['post-card', { 'post-card--featured': featured }]}>
  <PostCover slug={slug} tags={d.tags} cover={d.cover} size={featured ? 'featured' : 'card'} eager={featured} />
  <div class="post-card__body">
    <p class="post-card__meta">
      {d.draft ? <span class="badge">Coming soon</span> : <time datetime={d.pubDate.toISOString().slice(0, 10)}>{date}</time>}
      {!d.draft && minutes && <span> · {minutes} min read</span>}
      {d.external && <span> · on Medium</span>}
    </p>
    {!d.draft && d.stats && <p class="post-card__stats" title={`On Medium, as of ${asOf}`}>{plural(d.stats.claps, 'clap')} · {plural(d.stats.comments, 'comment')}</p>}
    <H class="post-card__title">
      {d.draft ? <span>{d.title}</span> : <a href={href} rel={d.external ? 'noopener' : undefined}>{d.title}{d.external && <span class="post-card__ext" aria-label="(opens on Medium)"> ↗</span>}</a>}
    </H>
    <p class="post-card__desc">{d.description}</p>
    <ul class="post-card__tags" aria-label="Tags">
      {d.tags.map((t) => <li><TagChip tag={t} current={t === currentTag} /></li>)}
    </ul>
  </div>
</article>

<style>
  .post-card {
    position: relative; display: flex; flex-direction: column; height: 100%; overflow: hidden;
    border: 1px solid var(--border); border-radius: 0.875rem; background: var(--bg);
  }
  .post-card:hover, .post-card:focus-within { border-color: color-mix(in oklch, var(--accent) 55%, var(--border)); }
  @media (prefers-reduced-motion: no-preference) {
    .post-card { transition: border-color 150ms ease, transform 200ms ease, box-shadow 200ms ease; }
    .post-card:hover { transform: translateY(-2px); box-shadow: 0 10px 30px -18px color-mix(in oklch, var(--fg) 45%, transparent); }
  }
  .post-card__body { display: flex; flex-direction: column; flex: 1; padding: 1rem 1.125rem 1.125rem; }
  .post-card__meta, .post-card__stats { font-family: var(--font-mono); font-size: 0.75rem; color: var(--muted); }
  .post-card__stats { margin-top: 0.25rem; }
  .post-card__title { margin-top: 0.375rem; font-size: 1.0625rem; font-weight: 600; line-height: 1.35; letter-spacing: -0.01em; }
  .post-card__title a { color: var(--fg); text-decoration: none; }
  /* The title link covers the whole card; tag chips sit above it. */
  .post-card__title a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .post-card__title a:focus-visible { outline: none; }
  .post-card__title a:focus-visible::after { outline: 2px solid var(--accent); outline-offset: -2px; border-radius: 0.875rem; }
  .post-card__ext { color: var(--muted); font-weight: 400; }
  .post-card__desc { margin-top: 0.5rem; font-size: 0.9375rem; color: var(--muted); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .post-card__tags { position: relative; z-index: 1; margin-top: auto; padding-top: 1rem; display: flex; flex-wrap: wrap; gap: 0.375rem; list-style: none; }
  @media (min-width: 768px) {
    .post-card--featured { flex-direction: row; }
    .post-card--featured > :global(.post-cover) { flex: 0 0 56%; aspect-ratio: auto; min-height: 18rem; }
    .post-card--featured .post-card__body { padding: 1.75rem; justify-content: center; }
    .post-card--featured .post-card__title { font-size: 1.625rem; }
    .post-card--featured .post-card__desc { font-size: 1rem; -webkit-line-clamp: 4; }
    .post-card--featured .post-card__tags { margin-top: 1.25rem; }
  }
</style>
