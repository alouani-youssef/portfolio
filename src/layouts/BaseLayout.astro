---
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { twinHref } from '../lib/markdown';
import { ogSlug } from '../lib/og-pages';
import { breadcrumbJsonLd } from '../lib/jsonld';
import CommandPalette from '../components/CommandPalette.astro';

export interface Props {
  title: string;
  description: string;
  path: string;
  jsonLd?: object[];
  noindex?: boolean;
  ogImage?: string;
  /** Set false for pages with no Markdown twin (tag pages, 404, drafts). */
  twin?: boolean;
  /** Blog posts set this so link previews and crawlers see an article with its dates. */
  article?: { published?: Date; modified?: Date; tags?: readonly string[] };
}
const { title, description, path, jsonLd = [], noindex = false, ogImage, twin = true, article } = Astro.props;
const site = Astro.site!.origin;
const og = ogImage ?? `/og/${ogSlug(path)}.png`;
const cfToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
const canonical = `${site}${path === '/' ? '/' : path}`;
const fullTitle = path === '/' ? title : `${title} · Youssef Alouani`;
const day = (d: Date) => d.toISOString().slice(0, 10);
const crumbs = noindex ? null : breadcrumbJsonLd(path, title, site);
const ld = crumbs ? [...jsonLd, crumbs] : jsonLd;
const themeScript = `(function(){try{var t=localStorage.getItem('theme');}catch(e){}var d=t?t==='dark':matchMedia('(prefers-color-scheme: dark)').matches;document.documentElement.dataset.theme=d?'dark':'light';})();`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={themeScript} data-theme-init></script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    {twin && <link rel="alternate" type="text/markdown" href={twinHref(path)} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-96.png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content="Youssef Alouani" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site}${og}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    {article?.published && <meta property="article:published_time" content={day(article.published)} />}
    {article?.modified && <meta property="article:modified_time" content={day(article.modified)} />}
    {article?.tags?.map((t) => <meta property="article:tag" content={t} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains" />
    {ld.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-bg focus:px-3 focus:py-2">Skip to content</a>
    <Header path={path}><CommandPalette slot="actions" /></Header>
    <main id="main" class="flex-1" data-pagefind-body={noindex || !twin ? undefined : true}>
      <slot />
    </main>
    <Footer path={path} />
    {cfToken && <script defer is:inline src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: cfToken })}></script>}
  </body>
</html>
